# Application
APP_NAME=Adaptive Agentic RAG
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json

# Networking
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Local model and persistence configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
CHROMA_PERSIST_DIRECTORY=database/chroma
CHROMA_COLLECTION_NAME=rag_chunks
METADATA_DATABASE_URL=sqlite:///database/metadata/app.db
UPLOAD_DIRECTORY=database/uploads

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RRF_CONSTANT=60
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=16
RERANKER_TOP_K=5

# Adaptive retrieval agent
AGENT_CONFIDENCE_THRESHOLD=0.65
AGENT_MAX_RETRIES=2

# Grounded generation
GENERATION_PROMPT_VERSION=v1
GENERATION_CONTEXT_MAX_CHARS=12000
GENERATION_MAX_OUTPUT_TOKENS=512
OLLAMA_TIMEOUT_SECONDS=120
