# Application
APP_NAME=Adaptive Agentic RAG
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json

# Networking
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Reserved for later milestones; no retrieval or model calls occur in Milestone 1.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
CHROMA_PERSIST_DIRECTORY=database/chroma
CHROMA_COLLECTION_NAME=rag_chunks
METADATA_DATABASE_URL=sqlite:///database/metadata/app.db
UPLOAD_DIRECTORY=database/uploads

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RRF_CONSTANT=60
